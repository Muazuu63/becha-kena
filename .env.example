# ==============================================================================
# বেচা-কেনা (Becha-Kena) — Backend Environment Configuration Example
# ==============================================================================

# 1. Server Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# 2. Database (MongoDB Atlas) & Cache (Redis)
MONGODB_URI=mongodb://localhost:27017/becha-kena
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 3. JWT Authentication & Refresh Tokens (Minimum 32 characters for security)
JWT_ACCESS_SECRET=becha_kena_super_secret_jwt_access_key_2026_dev
JWT_REFRESH_SECRET=becha_kena_super_secret_jwt_refresh_key_2026_dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 4. Cryptographic Signatures & PII Security
HMAC_CONTACT_SECRET=becha_kena_hmac_contact_reveal_secret_key_2026
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 5. Third-Party Integration: SMS Gateway (SSL Wireless)
SSL_WIRELESS_API_KEY=mock_ssl_wireless_api_key
SSL_WIRELESS_SID=mock_sid
SSL_WIRELESS_URL=https://smsplus.sslwireless.com/api/v3/send-sms

# 6. Third-Party Integration: Payment Gateway (bKash Sandbox)
BKASH_APP_KEY=mock_bkash_app_key
BKASH_APP_SECRET=mock_bkash_app_secret
BKASH_USERNAME=mock_bkash_username
BKASH_PASSWORD=mock_bkash_password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v2.0-beta

# 7. Third-Party Integration: Payment Gateway (Nagad Sandbox)
NAGAD_MERCHANT_ID=mock_nagad_merchant_id
NAGAD_PUBLIC_KEY=mock_nagad_public_key
NAGAD_PRIVATE_KEY=mock_nagad_private_key
NAGAD_BASE_URL=https://api.mynagad.com/api/dfs

# 8. Third-Party Integration: AWS S3 / Cloud Storage
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=mock_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key
AWS_S3_BUCKET_PUBLIC=becha-kena-public-assets
AWS_S3_BUCKET_PRIVATE=becha-kena-private-kyc

# 9. Third-Party Integration: Google Cloud Services
GOOGLE_VISION_KEY=mock_google_vision_api_key
GOOGLE_MAPS_API_KEY=mock_google_maps_api_key
RECAPTCHA_SECRET_KEY=mock_recaptcha_secret_key

# 10. Autonomous Dev / Testing Mock Toggles (Set true for local dev without live external credentials)
ENABLE_MOCK_SMS=true
ENABLE_MOCK_OCR=true
ENABLE_MOCK_PAYMENT=true
