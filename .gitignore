# ==============================================================================
# বেচা-কেনা (Becha-Kena) — Backend Production .gitignore
# ==============================================================================

# 1. Dependency Directories
node_modules/
jspm_packages/
.pnp
.pnp.js

# 2. Production Build & Transpiled Outputs
dist/
build/
out/
*.tsbuildinfo

# 3. Environment Variables, Secrets & Credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Explicitly track .env.example for team reference
!.env.example

# 4. Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Testing & Code Coverage
coverage/
.nyc_output/
*.lcov
junit.xml

# 6. Temporary Files & Local Uploads Cache
temp/
tmp/
.temp/
uploads/
*.tmp
*.temp

# 7. Operating System Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# 8. IDE & Code Editor Files
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/

# VS Code (Ignore user state, keep shared settings if needed)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
